3. Reverse left half pyramid
public class Star {
	public static void main(String[] args) {
		int n=6;
		for(int i=1;i<=n;i++) {  //rows
			for(int k=1;k<=i;k++)//spaces(use i for L-H(1_5))(spaces increasing)
			{
				System.out.print(" ");
				}
				for(int j=1;j<=n-i;j++) { //stars(use n-1(5) for H-L(5-1))(stars decreasing)
					
					System.out.print("*");
				
			}
				System.out.println();
		}
	}

}

