10. center aligned hollow triangle:

public class Stars {
	public static void main(String[] args) {
		int n=9;
		for(int i=1;i<=n;i++) {
			for(int k=1;k<=n-i;k++) {  //to find center position print spaces, after printing spaces it becomes the starting column1
				System.out.print(" "); // move the cursor to the center by printing(n-1)leading spaces
			}
			for(int j=1;j<=2*i-1;j++) { 
			//from here we draw the triangle according to stars positions(1,3,5,7 ...stars in each row like r1s2,r2,s3,r3,s5(s=stars, r-rows))
			//1,3,5,7 is the right left border for that we write the formula as j=2*i-1
				if(i==n||j==1||j==2*i-1) { // bottom border(i==n),left border(j==1), right border(j==2*i-1)
					System.out.print("*");
				}else {
					System.out.print(" ");
				}
			}
			System.out.println();
		}	
}
	}
