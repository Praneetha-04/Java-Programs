package javaprogram;
//to print sum of first 10 odd numbers

public class Sum {
public static void main(String[] args) {
	int n = 10;
	int sum= 0;
	for(int i=1;i<=n;i++) {
		if(i%2!=0) {
			sum=sum+i; // 1+3+5+7+9=25
		}
		
	}
	System.out.println(sum);

}
